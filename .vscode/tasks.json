{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "swag-fmt-init",
      "type": "shell",
      "command": "swag fmt && swag init",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "gorm-gen",
      "type": "shell",
      "command": "gorm gen -i ./database/model -o ./database/generated",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "pre-launch-tasks",
      "dependsOn": [
        "swag-fmt-init"
      ],
      "problemMatcher": []
    }
  ]
}